  "training": {
    "dataset": "tinystories",
    "batch_size": 32,
    "max_steps": 50000,
    "lr": 3e-4,
    "warmup_steps": 1000,
    "curriculum_steps": [
      [0,     256],
      [10000, 512],
      [25000, 1024],
      [40000, 2048]
    ]
  }
}
