{
  "_comment": "Nano model config (~15M params) for TinyStories validation on Colab",
  "vocab_size": 32000,
  "n_layers": 4,
  "d_model": 256,
  "num_heads": 4,
  "latent_dim": 64,
  "state_dim": 16,
  "n_experts": 8,
